@using URegister.Core.Models.OpenData
@model OpenDataRegisterVM

@{
    ViewBag.Title = "Стартиране на OpenData";
}
<div class="ui grid">
    <form class="ui sixteen wide column"  method="post" enctype="multipart/form-data">
        <div class="content">
            <div class="column ui segment green">
                <div class="ui form">
                    <div class="fields">
                    <div class='sixteen wide field'>
                            @Html.EditorFor(model => model.CategoryId, "DropDownInt")
                        </div>
                    </div>
                </div>
             </div>
            @await Html.PartialAsync("_BackSubmitButton", @Url.Action("Index", "PublicFieldTemplate", new { area = "Admin" }))
        </div>
    </form>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}