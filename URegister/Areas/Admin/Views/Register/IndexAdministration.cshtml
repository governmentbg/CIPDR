@{
    ViewData["Title"] = "Администрации";
}
@Html.AntiForgeryToken()
<div id="administrationsContainer" class="ui grid">
    <div class="column">
         <div class="column">
            <table 
                id="administrations" 
                class="ui celled striped very compact table" style="width:100%; padding:0px;"
                   data-url="@Url.Action("GetAdministrationList", "Register")"
                   data-add-url="@Url.Action("AddAdministration", "Register")">
             </table>
        </div>
    </div>
</div>
@await Html.PartialAsync("_BackButton", @Url.Action("Index", "Home", new {area =""}))
@section Scripts
{
    <script src="~/js/admin/register/administrationList.js" asp-append-version="true"></script>
}
