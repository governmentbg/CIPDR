@{
    Layout = String.Empty;
    ViewBag.Title = "Отказан достъп до ресурса";
}


<!DOCTYPE html>
<html>
<head>
    <!-- Standard Meta -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

    <link rel="stylesheet" href="~/library/fomantic-ui/semantic.min.css" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/library/fomantic-ui/semantic.min.js"></script>

    <style type="text/css">
        body {
            background-color: #DADADA;
        }

            body > .grid {
                height: 100%;
            }

        .image {
            margin: 20px 0 20px 0;
        }

        html, body {
            height: 100%;
        }

        .column {
            max-width: 450px;
        }
    </style>
</head>
<body>

<div class="ui middle aligned center aligned grid">
    <div class="column">
        <img src="/images/login-logo.svg" class="ui fluid image">
        <div class="ui message">
            <div style="text-align:center;">
                <h4 class="text-danger">Отказан достъп до ресурса</h4>
            </div>
                
        </div>
        <a asp-controller="Account" asp-action="Logout" class="ui yellow button">
            Изход
        </a>
    </div>
</div>

</body>

</html>
@{
    await Html.RenderPartialAsync("_UserMessages");
}