@using URegister.Core.Models.Service
@model PublicFieldTemplateVM
@{
    ViewBag.Title = $"Съдържание на публично поле '{Model.Label}'";
}
<form id="submit" action="@Url.Action("EditContent")" method="post" enctype="multipart/form-data">
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.Label)
    @Html.HiddenFor(x => x.FieldName)
    @Html.HiddenFor(x => x.ContentText)
    <div class="ui grid">
        <div class="ui sixteen wide column content">
            <div class="column ui segment green">
                <div class="ui form">
                    <div class="fields">
                        <div class='sixteen wide field'>
                            <textarea class="blank-editor" asp-for="@Model.Content"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="ui fluid container basic clearing segment"></div>
    @await Html.PartialAsync("_BackSubmitButton", @Url.Action("Index"))
</form>
@section Scripts
{
    <script src="~/js/admin/public_field_template/tinymce_init.js" asp-append-version="true"></script>
}
