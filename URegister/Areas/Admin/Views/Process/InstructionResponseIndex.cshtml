@using URegister.Core.Models.Process
@model InstructionVM
@{
    ViewBag.Title = "Изпълнения на указание";
    var addUrl = Model.CanAdd ? @Url.Action("AddInstructionResponse", "Process", new { instructionId = Model.Id }) : string.Empty;
}
@Html.AntiForgeryToken()
@Html.HiddenFor(x => x.ProcessId)
@Html.HiddenFor(x => x.Id)
<div class="ui grid">
    <div class="column">
        <table id="instructionResponses"
               class="ui celled striped very compact table" style="width:100%; padding:0px;"
               data-url="@Url.Action("GetInstructionResponseList", "Process")"
               data-add-url="@addUrl">
        </table>
    </div>
</div>
@await Html.PartialAsync("_BackButton", @Url.Action("Index"))
@section Scripts
{
    <script src="~/js/admin/process/instructionResponseList.js" asp-append-version="true"></script>
}
