@using URegister.Core.Models.Process
@model ProcessVM
@{
    ViewData["Title"] = "Услуга за промяна/заличаване";
}

<div class="ui segments">
    <form action="@Url.Action("AddChange")" method="post" id="submit" novalidate enctype="multipart/form-data">
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.FromProcessId)
        <div class="ui green clearing segment">
            <div class="ui form">
                <div class="fields">
                    <div class='sixteen wide field'>
                        @Html.EditorFor(model => model.ServiceId, "DropDownInt")
                    </div>
                </div>
                @await Html.PartialAsync("_BackSubmitButton", @Url.Action("Index"))
            </div>
        </div>
    </form>

</div>

