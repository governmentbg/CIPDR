@using URegister.Core.Models.Process
@model ProcessVM
@{
    ViewData["Title"] = "Въвеждане на стари вписвания";
}

<div class="ui segments">
    <form action="@Url.Action("AddOld")" method="post" id="submit" novalidate enctype="multipart/form-data">
        @Html.HiddenFor(m => m.Id)
        <div class="ui green clearing segment">
            <div class="ui form">
                 <div class="fields">
                    <div class="four wide field">
                        @Html.EditorFor(model => model.OldIncomingNumber, "String")
                    </div>
                    <div class="four wide field">
                        @Html.EditorFor(model => model.OldIncomingDate, "DateTime")
                    </div>
                </div> 
                <div class="fields">
                    <div class='sixteen wide field'>
                        @Html.EditorFor(model => model.ServiceId, "DropDownInt")
                    </div>
                </div>
                @await Html.PartialAsync("_BackSubmitButton", @Url.Action("Index"))
            </div>
        </div>
    </form>

</div>

