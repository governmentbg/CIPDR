@using URegister.Core.Models.Process
@model ProcessStepVM
@{
    ViewData["Title"] = Model.FormTitle;
    var htmlFieldPrefix = ViewData.TemplateInfo.HtmlFieldPrefix;
}

<div class="ui segments">
    <div class="ui green clearing segment">
        <form action="@Url.Action("AddStep")" method="post" id="submit" novalidate enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.ProcessId)
            @Html.HiddenFor(m => m.ServiceStepId)
            @Html.HiddenFor(m => m.ServiceId)
            @Html.HiddenFor(m => m.OrderNum)
            @Html.HiddenFor(m => m.FormParentId)
            @Html.HiddenFor(m => m.SelectedType)
            @Html.HiddenFor(m => m.DontUploadFilesToStorage)
            @Html.HiddenFor(m => m.UserTimeZoneOffsetInMinutes)
            @Html.HiddenFor(m => m.ConditionTree)
            @if (!string.IsNullOrEmpty(Model.ProcessInfo?.ReasonForRejection))
            {
                <div class="content">
                    <div class="ui form">
                        <div class="field">
                            <label asp-for="@Model.ProcessInfo.ReasonForRejection">Причина за прекратяване</label>
                            <textarea asp-for="@Model.ProcessInfo.ReasonForRejection" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            }
            @{
                ViewData.TemplateInfo.HtmlFieldPrefix = string.IsNullOrEmpty(htmlFieldPrefix) ? "ProcessInfo" : $"{htmlFieldPrefix}.ProcessInfo";
                await Html.RenderPartialAsync("_ProcessInfo", Model.ProcessInfo);
                ViewData.TemplateInfo.HtmlFieldPrefix = htmlFieldPrefix;
            }
            @{
                await Html.RenderPartialAsync("FormFieldArranger", Model.FormFields);
            }
            @await Html.PartialAsync("_BackButton", @Url.Action("Index"))
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/uuid/uuidv4.min.js"></script>
    <script src="~/js/admin/designer/showPreview.js" asp-append-version="true"></script>
}

