@using URegister.Core.Models.Process
@model InstructionResponseItemVM
@{
    var htmlFieldPrefix = ViewData.TemplateInfo.HtmlFieldPrefix;
    ViewBag.Title = "Изпълнение на указание";
}
<form action="@Url.Action("InstructionResponseEdit")" method="post" enctype="multipart/form-data">
    @Html.HiddenFor(x => x.Id)
    @Html.HiddenFor(x => x.ProcessId)
    @Html.HiddenFor(x => x.InstructionId)
    <div class="ui grid">
        <div class="ui sixteen wide column content">
            <div class="column ui segment green">
                <div class="ui form">
                    <div class="fields">
                        <div class='sixteen wide field'>
                            @Html.EditorFor(x => x.Content, "String")
                        </div>
                    </div>
                    @{
                        ViewData.TemplateInfo.HtmlFieldPrefix = "Files";
                        @await Html.PartialAsync("_AttachedFiles", Model.Files)
                        ;
                        ViewData.TemplateInfo.HtmlFieldPrefix = htmlFieldPrefix;
                    }

                </div>
            </div>
        </div>
    </div>
    <div class="ui fluid container basic clearing segment"></div>
    @await Html.PartialAsync("_BackSubmitButton", @Url.Action("InstructionIndex", new { processId = Model.ProcessId }))
</form>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}