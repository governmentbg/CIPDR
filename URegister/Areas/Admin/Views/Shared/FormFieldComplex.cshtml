@using URegister.Infrastructure.Model.RegisterForms
@model URegister.Infrastructure.Model.RegisterForms.FormField
@{
    string toolTip = string.IsNullOrEmpty(Model.Tooltip) ? string.Empty : Model.Tooltip;

    if (Model.IsReadonly)
    {
        foreach (FormField subField in Model.Fields)
        {
            subField.IsReadonly = true;
        }
    }
    if (!Model.IsRequired)
    {
        foreach (FormField subField in Model.Fields)
        {
            subField.IsRequired = false;
        }
    }
    else
    {
        //#391449 Експериментално за полетата с адрес
        foreach (FormField subField in Model.Fields)
        {
            if (subField.Name.EndsWith("settlementImmutable") || 
                subField.Name.EndsWith("streetImmutable") ||
                subField.Name.EndsWith("countryImmutable"))
            {
                subField.IsRequired = true;
            }
        }
    }
}
<div class="ui form">
    <div class="field" name="@Model.Name">
        <fieldset class="fieldgroup-fieldset @(Model.IsReadonly ? "readonly-fieldset" : "")">
            <legend class="person-tooltip"
                    @if (!string.IsNullOrEmpty(toolTip))
                    {
                        <text>data-content="@toolTip"</text>
                    }>@Model.Label</legend>
            @{
                await Html.RenderPartialAsync("FormFieldArranger", Model.Fields?.ToList());
            }
        </fieldset>
    </div>
</div>