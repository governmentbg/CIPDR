@using URegister.Core.Models.Service
@model BlanksTemplateVM
@{
    var htmlFieldPrefix = ViewData.TemplateInfo.HtmlFieldPrefix;
    var htmlFieldPrefixP = string.IsNullOrEmpty(htmlFieldPrefix) ? string.Empty : $"{htmlFieldPrefix}.";
    var dataIndex = Model.BlankSignatures.Count;
}
<div class="ui form">
    <fieldset>
        <legend>
            <b>&nbsp; Подписи &nbsp;</b>
        </legend>
        <div id="SignatureList">
            <div id="main-container" class="signature-container" data-index="@dataIndex" data-prefix="@htmlFieldPrefix">
                @for (int i = 0; i < Model.BlankSignatures.Count; i++)
                {
                    Model.BlankSignatures[i].Index = i;
                    ViewData.TemplateInfo.HtmlFieldPrefix = $"{htmlFieldPrefix}BlankSignatures[{i}]";
                    await Html.RenderPartialAsync("_Signature", Model.BlankSignatures[i]);
                    ViewData.TemplateInfo.HtmlFieldPrefix = htmlFieldPrefix;
                }
            </div>
        </div>
        <div class="ui fluid container basic clearing segment"></div>
        <div class="fields">
            <div class='sixteen wide field'>
                <div class="ui buttons right floated">
                    <button type="button" class=" ui button add-item" data-url="@Url.Action("AddBlankSignature")" data-container-id="main-container">
                        <i class="add icon"></i>
                        Добави
                    </button>
                </div>
            </div>
        </div>

    </fieldset>
</div>