@using URegister.Core.Models.Service
@using URegister.Infrastructure.Constants
@using URegister.Infrastructure.Extensions
@model ServiceStepVM

@{
    var currentHtmlPrefix = ViewData.TemplateInfo.HtmlFieldPrefix;
    var indexPath = currentHtmlPrefix.GetIndexPath();
    var displayCoordination = Model.StepId == (int)ServiceSteps.Coordination ? string.Empty : "display:none";
}
<div class="ui sixteen wide field content item-template draggable" data-id="@Model.OrderNum">
    <input type="hidden" name="@indexPath" value="@Model.Index" />
    <div class="column ui segment green">
        <div class="ui form">
            <div class="fields">
                @Html.HiddenFor(model => model.Id)
                @Html.TextBoxFor(model => model.OrderNum, new { type = "hidden", @class = "order-input" })
                <div class='three wide field'>
                    @Html.EditorFor(model => model.StepId, "DropDownInt", new { onchange = "stepTypeChange(this)"})
                </div>
                <div class='three wide field'>
                    @Html.EditorFor(model => model.StatusId, "DropDownInt", new { Ddl = ViewData[$"{NomenclatureTypes.Status}_ddl"]})
                </div>
                <div class='three wide field coordination-item' style="@displayCoordination">
                    @Html.EditorFor(model => model.Name)
                </div>
                <div class='six wide field coordination-item' style="@displayCoordination">
                    @Html.EditorFor(model => model.Roles, "DropDownGuidMultiple")
                </div>
                <div class="one wide field center-item-container">
                    @await Html.PartialAsync("_RemoveItem")
                </div>
            </div>
        </div>
    </div>
</div>

