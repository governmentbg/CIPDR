@using URegister.Core.Models.Service
@model ServiceVM

@{
    ViewBag.Title = Model.IsInsert ? "Добавяне на услуга" : "Редакция на услуга";
}

<div class="ui grid">   
    <form id="formService" class="ui sixteen wide column" action="@Url.Action("Edit", "Service")" method="post" enctype="multipart/form-data">
        <div class="content">           
            <div class="column ui segment green">
                <div class="ui form">
                    @Html.HiddenFor(model => model.Id)
                    <div class="fields">
                        <div class='sixteen wide field'>
                            @Html.EditorFor(model => model.Name, "String")
                        </div>
                    </div>
                    <div class="fields">
                        <div class='sixteen wide field'>
                            @Html.EditorFor(model => model.ServiceTypeId, "DropDownInt", new { @class = "service-type-id" })
                        </div>
                    </div>
                    <div class="fields">
                        <div class='sixteen wide field'>
                            @Html.EditorFor(model => model.FormParentId, "DropDownInt")
                        </div>
                    </div>
                    <div class="fields">
                        <div class='sixteen wide field'>
                            @Html.EditorFor(model => model.EFormCode, "String")
                        </div>
                    </div>
                </div>
            </div>
           
            <div class="column ui segment green">
                <div class="ui form">
                    <div class="fields">
                        <div class='sixteen wide field step-list'>
                            @await Html.PartialAsync("_StepList", Model)
                        </div>
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("_BackSubmitButton", @Url.Action("Index"))
        </div>
    </form>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <link href="~/library/jqueryui/themes/smoothness/jquery-ui.min.css" rel="stylesheet" />
    <script src="~/library/jqueryui/jquery-ui.min.js"></script>
    <script src="~/js/admin/service/serviceEdit.js" asp-append-version="true"></script>

}
