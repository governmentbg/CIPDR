@using URegister.Core.Models.Common
@using URegister.Infrastructure.Extensions

@model PersonIdentifierVM
@{
    var ddl = ViewData.GetDropDownDdl().SetSelected(Model.PidType!);
    var onchange = (string)(ViewData["onchange"] ?? String.Empty);
    var class_css = (string)(ViewData["class"] ?? String.Empty);
    var container_css = (string)(ViewData["container_css"] ?? String.Empty);
}

<div class="ui form person-identifier">
    <div class="field">
        <div class="field">
            <label asp-for="@Model"></label>
            <div class="ui left labeled input">
                <div class="ui dropdown label">
                    @Html.HiddenFor(x => x.PidType)
                    <div class="text pid-text">Тип</div>
                    <i class="dropdown icon"></i>
                    <div class="menu">
                        @foreach (SelectListItem item in ddl)
                        {
                            <div class="item" data-value="@item.Value">@item.Text</div>
                        }
                    </div>
                </div>
                <input class="ui input"  type="text" asp-for="@Model.Pid">
            </div>
            
        </div>
    </div>
</div>