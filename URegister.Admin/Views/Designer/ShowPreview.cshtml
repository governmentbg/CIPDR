@model URegister.Infrastructure.Model.RegisterForms.FormViewModel
@{
    ViewData["Title"] = $"Изглед на '{Model.FormTitle}'";
}

<div class="ui segments">
    <div id="showPreviewFields" class="ui green clearing segment">
    <form action="@Url.Action("ShowPreview", "Designer")" method="post" id="submit" novalidate enctype="multipart/form-data">
        @Html.HiddenFor(m => m.FormParentId)
        @Html.HiddenFor(m => m.FormTitle)
        @Html.HiddenFor(m => m.SelectedType)
        @Html.HiddenFor(m => m.UserTimeZoneOffsetInMinutes)
        @Html.AntiForgeryToken()
        @{
            await Html.RenderPartialAsync("FormFieldArranger", Model.FormFields);
        }
        <div class="fields">
            <input class="ui primary right floated button" type="submit" value="Валидирай"/>
                <a href="@Url.Action("ConfigureFields", "Designer", new { preSelectedType = @Model.SelectedType })" class="ui right floated button"><i class="arrow left icon"></i> Назад</a>
            </div>
    </form>
    </div>
    <div class="ui segment">
        <div class="ui toggle checked checkbox">
            <input type="checkbox" onclick="frontEndValidation(this)">
            <label>Front-end валидация</label>
        </div>
    </div>
</div>
@{
    await Html.RenderPartialAsync("_ConfirmAction");
}
@section Scripts {
    <script src="~/js/uuid/uuidv4.min.js"></script>
    <script src="~/js/designer/showPreview.js" asp-append-version="true"></script>
}