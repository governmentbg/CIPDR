@model LoginViewModel
@{
    Layout = String.Empty;
    ViewBag.Title = "Вход в системата";
}


<!DOCTYPE html>
<html>
<head>
    <!-- Standard Meta -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

    <!-- Site Properties -->
    <title>НЗИС - @ViewData["Title"]</title>

    <link rel="stylesheet" href="~/library/fomantic-ui/semantic.min.css" />
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/library/fomantic-ui/semantic.min.js"></script>

    <style type="text/css">
        body {
            background-color: #DADADA;
        }

            body > .grid {
                height: 100%;
            }

        .image {
            margin: 20px 0 20px 0;
        }

        html, body {
            height: 100%;
        }

        .column {
            max-width: 450px;
        }
    </style>
</head>
<body>

    <div class="ui middle aligned center aligned grid">
        <div class="column">
            <img src="/images/login-logo.svg" class="ui fluid image">
            <div class="ui message">
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <form id="external-account" asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div>
                            @foreach (var provider in Model.ExternalLogins)
                            {
                                <button type="submit" class="ui yellow fluid large button" name="provider" value="@provider.Name" title="Вход с @provider.DisplayName">Вход с @provider.DisplayName</button>
                            }
                        </div>
                        @if (ViewBag.errorMessage != null)
                        {
                            <br />
                            <div style="text-align:center;">
                                <h4 class="text-danger">@ViewBag.errorMessage</h4>
                            </div>
                        }
                    </form>
                }
            </div>
        </div>
    </div>

</body>

</html>