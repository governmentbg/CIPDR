@using URegister.Core.Models.Register
@using URegister.Infrastructure.Constants
@model RegisterVM

@{
    ViewBag.Title ="Редакция на регистър";
    var htmlFieldPrefix = ViewData.TemplateInfo.HtmlFieldPrefix;
    var dataIndex = Model.ContactPersons.Count;
}
<div class="ui grid">
    <form class="ui sixteen wide column" action="@Url.Action("EditRegister")" method="post" enctype="multipart/form-data">
        <div class="content">
            @Html.HiddenFor(model => model.Id)
            <div class="column ui segment green">
                <div class="ui form">
                    <div class="fields">
                        <div class='sixteen wide field'>
                            <h3>ЗАЯВЯВАМ ИЗГРАЖДАНЕ НА СЛЕДНИЯ РЕГИСТЪР</h3>
                        </div>
                    </div>
                    <div class="fields">
                        <div class='four wide field'>
                            @Html.EditorFor(model => model.Code, "StringDisabled")
                        </div>
                        <div class='twelve wide field'>
                            @Html.EditorFor(model => model.Name, "String")
                        </div>
                    </div>
                    <div class="fields">
                        <div class="sixteen wide field">
                            @Html.EditorFor(model => model.Description, "TextArea")
                        </div>
                    </div>
                    <div class="fields">
                        <div class="sixteen wide field">
                            @Html.EditorFor(model => model.LegalBasis, "String")
                        </div>
                    </div>
                    <div class="fields">
                        <div class='three wide field'>
                            @Html.EditorFor(model => model.Type, "DropDown", new { Ddl = ViewData[$"{InternalNomenclatureTypes.RegisterType}_ddl"] })
                        </div>
                        <div class='three wide field'>
                            @Html.EditorFor(model => model.TypeEntry, "DropDown", new { Ddl = ViewData[$"{InternalNomenclatureTypes.RegisterEntryType}_ddl"] })
                        </div>
                        <div class='seven wide field'>
                            @Html.EditorFor(model => model.IdentitySecurityLevel, "DropDown", new { Ddl = ViewData[$"{InternalNomenclatureTypes.RegisterIdentitySecurityLevel}_ddl"] })
                        </div>
                        <div class='three wide field'>
                            @Html.EditorFor(model => model.HistoryNotPublic, "CheckBoxBoolean")
                        </div>
                    </div>
                </div>
            </div>
            <div class="column ui segment green register-info">
                @{
                    ViewData.TemplateInfo.HtmlFieldPrefix = $"RegisterFiles";
                    await Html.RenderPartialAsync("_RegisterFiles", Model.RegisterFiles);
                    ViewData.TemplateInfo.HtmlFieldPrefix = htmlFieldPrefix;
                }
            </div>
            @await Html.PartialAsync("_BackSubmitButton", @Url.Action("Index"))
        </div>
    </form>
</div>
@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}