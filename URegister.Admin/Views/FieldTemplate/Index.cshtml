@{
    ViewData["Title"] = "Бланки";
}

<div class="ui grid">
    <div class="column">
        <div class="column">
            <table id="field_template"
                class="ui celled striped very compact table" style="width:100%; padding:0px;"
                   data-url="@Url.Action("GetFieldTemplateList", "FieldTemplate")"
                   data-add-url="@Url.Action("Add", "FieldTemplate")">
             </table>
        </div>
    </div>
</div>
@await Html.PartialAsync("_BackButton", @Url.Action("Index", "Home"))
@{
    await Html.RenderPartialAsync("_ConfirmAction");
}
@section Scripts
{
    <script src="~/js/field_template/fieldTemplateList.js" asp-append-version="true"></script>
}
