@using URegister.Core.Models
@model CalendarFilterVM
@{
    ViewData["Title"] = "Календар";
}
@Html.AntiForgeryToken()
<div class="ui grid">
    <div class="column">
        <div class="ui fluid container basic clearing">
            <div class="ui accordion">
                <div class="title">
                    <i class="dropdown icon"></i>
                    Филтър
                </div>
                <div class="content">
                    <div class="column ui segment green">
                        <div class="ui form">
                            <div class="fields">
                                <div class="three wide field">
                                    @Html.EditorFor(model => model.DateFrom, "DateTime")
                                </div>
                                <div class="three wide field">
                                    @Html.EditorFor(model => model.DateTo, "DateTime")
                                </div>
                                <div class="ui ten wide right aligned field custom buttons">
                                    <div class="ui fluid container basic clearing">
                                        <a href="javascript:LoadCalendar()" class="ui primary button right floated" style="margin-top:1.5rem">
                                            <i class="icon search"></i>
                                            Търси
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <table id="calendar_days"
               class="ui celled striped very compact table" style="width:100%; padding:0px;"
               data-url="@Url.Action("GetCalendarList", "Calendar")"
               data-add-url="@Url.Action("Add", "Calendar")">
        </table>
    </div>
</div>
@await Html.PartialAsync("_BackButton", @Url.Action("Index", "Home", new { area = "" }))
@section Scripts
{
    <script src="~/js/calendar/calendarList.js" asp-append-version="true"></script>
}
